generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id String @id @default(uuid())

  email String @unique
  password String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

model OutboxEvent {
  id String @id @default(uuid())

  eventType String
  payload Json

  status OutboxStatus @default(PENDING)

  attempts Int @default(0)

  createdAt DateTime @default(now())
  processedAt DateTime?
}

